    {
      "parameters": {
        "jsCode": "const salesSummary = $('calculate sales summury').all()[0]?.json || {};\nconst productSales = $('calculate product sales').all() || [];\nconst customerAnalysis = $('customer analysis').all() || [];\nconst refunds = $('calculate refunds').all() || [];\n\nreturn [{\n  json: {\n    reportDate: new Date().toISOString(),\n    totalSales: salesSummary.totalSales || 0,\n    totalOrders: salesSummary.totalOrders || 0,\n    totalProductsSold: productSales.length,\n    totalCustomers: customerAnalysis.length,\n    totalRefunds: refunds.length\n  }\n}];"
      },
