        "jsCode": "for (const item of $input.all()) {\n  const html = item.json.html;\n  const fileName = \"invoice.html\";\n  const buffer = Buffer.from(html, 'utf-8');\n  \n  item.binary = {\n    data: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/html',\n      fileName: fileName,\n      fileSize: buffer.length\n    }\n  };\n}\nreturn $input.all();"
