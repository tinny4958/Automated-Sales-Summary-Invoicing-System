      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const data = item.json;\n  item.json = {\n    \"order name\": `Order #${data.id}`,\n    \"order id\": data.id,\n    \"order number\": data.id,\n    \"customer email\": data.billing ? data.billing.email : \"N/A\",\n    \"invoice date\": data.date_created,\n    \"total ammount\": parseFloat(data.total),\n    \"oder status\": data.status\n  };\n}\nreturn $input.all();"
      },
