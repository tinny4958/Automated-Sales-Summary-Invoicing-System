    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const data = item.json;\n  \n  const invoiceHtml = `\n  <html>\n    <head>\n      <style>\n        body { font-family: Arial, sans-serif; }\n        .invoice-box { max-width: 800px; padding: 30px; border: 1px solid #eee; margin: auto; }\n        .header { font-size: 24px; font-weight: bold; margin-bottom: 20px; }\n      </style>\n    </head>\n    <body>\n      <div class=\"invoice-box\">\n        <div class=\"header\">Invoice for ${data[\"order name\"]}</div>\n        <p><strong>Order ID:</strong> ${data[\"order id\"]}</p>\n        <p><strong>Customer Email:</strong> ${data[\"customer email\"]}</p>\n        <p><strong>Invoice Date:</strong> ${data[\"invoice date\"]}</p>\n        <p><strong>Total Amount:</strong> $${data[\"total ammount\"]}</p>\n        <p><strong>Status:</strong> ${data[\"oder status\"]}</p>\n      </div>\n    </body>\n  </html>\n  `;\n  \n  item.json.html = invoiceHtml;\n}\nreturn $input.all();"
      },
