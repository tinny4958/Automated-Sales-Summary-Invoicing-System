    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst customerAnalysis = {};\n\nfor (const item of items) {\n  const customerId = item.json.customer_id;\n  const orderTotal = parseFloat(item.json.total || 0);\n\n  if (customerId !== undefined && customerId !== null) {\n    if (customerAnalysis[customerId]) {\n      customerAnalysis[customerId].totalSpent += orderTotal;\n      customerAnalysis[customerId].orderCount += 1;\n    } else {\n      customerAnalysis[customerId] = {\n        customerId: customerId,\n        totalSpent: orderTotal,\n        orderCount: 1\n      };\n    }\n  }\n}\n\nreturn Object.values(customerAnalysis).map(data => {\n  return {\n    json: data\n  };\n});"
      },
