        "jsCode": "let totalSales = 0;\nconst items = $input.all();\n\nfor (const item of items) {\n  const orderTotal = parseFloat(item.json.total || 0);\n  totalSales += orderTotal;\n}\n\nreturn [{\n  json: {\n    totalSales: totalSales,\n    totalOrders: items.length\n  }\n}];"
      },
